// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ## โมเดลสำหรับผู้ใช้งาน (User)
model User {
  id        String  @id @map("id")
  email     String  @unique
  name      String? // จาก Google profile
  avatarUrl String? @map("avatar_url") // URL รูปจาก Google
  provider  String? // เช่น "google"
  googleId  String? @map("provider_id") // ID จาก Google

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  entries      Entry[]
  ThankMessage ThankMessage[]
  userHasSeed  UserHasSeed[]
  garden       Garden[]
  stackRecord  StackRecord?

  // Map Model name "User" to table name "users"
  @@map("users")
}

// ## โมเดลสำหรับบันทึก (Entry)
model Entry {
  id    String  @id @default(uuid())
  line1 String
  line2 String?
  line3 String?
  email String
  mood  Mood
  // ✅ เก็บคะแนนเป็นตัวเลข (-2..+2)
  moodScore Int      @db.SmallInt  @map("mood_score")
  // Map camelCase fields to snake_case columns
  showMessage Boolean  @default(false) @map("show_message")
  isDelete    Boolean  @default(false) @map("is_delete")
  createdAt   DateTime @default(now()) @map("created_at")
  imageUrls   String[] @default([]) @map("image_urls")

  // Relation fields
  user   User   @relation(fields: [userId], references: [id])
  userId String @map("user_id") // Foreign key

  // ✅ ดัชนีสำหรับ query ตามผู้ใช้+ช่วงเวลา (สัปดาห์/เดือน)
  @@index([userId, createdAt])
  // Map Model name "Entry" to table name "entries"
  @@map("entries")
}

model ThankMessage {
  id           String   @id @default(uuid())
  thankMessage String   @map("thank_message")
  isDelete     Boolean  @default(false) @map("is_delete")
  createdAt    DateTime @default(now()) @map("created_at")
  // Relation fields
  user         User?    @relation(fields: [userId], references: [id])
  userId       String?  @map("user_id") // Foreign key
  @@map("thank_messages")
}

// Model สำหรับเก็บของมูล Seed ในโมดูล Seed Stack
model Seed {
  id               String  @id @default(uuid())
  nameEng          String
  nameTH           String
  description      String
  growthDays       Int
  icon             String
  renderType       RenderType
  imageStages      String[]
  animationFile    String
  animationKey     String
  rarity           Rarity
  emotionTag       Mood
  unlockCondition  String
  available        Boolean @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  userHasSeed      UserHasSeed[]
  garden           Garden[]
  stackRecord      StackRecord[]
}

// Model สำหรับเก็บข้อมูลการครอบครอง Seed ของ User
model UserHasSeed {
  id          String    @id @default(uuid())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  // Relate with 
  user        User  @relation(fields: [userId], references: [id])
  userId      String // Foreign key for table User
  seed        Seed  @relation(fields: [seedId], references: [id])
  seedId      String // Foreign key for table Seed
}

// Model สำหรับเก็บของมูล Collection ของ User
model Garden {
  id          String  @id @default(uuid())
  growthDays  Int
  plantAt     DateTime
  bloomAt     DateTime
  memory      String
  isFavorite  Boolean
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  // Relate with
  user        User  @relation(fields: [userId], references: [id])
  userId      String // Foreign key for table User
  seed        Seed  @relation(fields: [seedId], references: [id])
  seedId      String // Foreign key for table Seed
}

// Model สำหรับเก็บของมูล Seed Stack ของ User
model StackRecord {
  id        String @id @default(uuid())
  stack     Int
  status    PlantStatus
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  // Relate with
  user      User  @relation(fields: [userId], references: [id])
  userId    String @unique  // Foreign key for table User
  seed      Seed  @relation(fields: [seedId], references: [id])
  seedId    String // Foreign key for table Seed
}

// ## Enum สำหรับอารมณ์
enum Mood {
  happy
  calm
  neutral
  tired
  sad
}

//  Enum รูปแบบการ Render Animation ในโมดูล Seed Stack
enum RenderType {
  statics
  lottie
  sprite
}

// Enum ความหายากของ Seed ในโมดูล Seed stack
enum Rarity {
  common
  rare
  epic
  legendary
  season
}

enum PlantStatus {
  growing
  bloomed
  withered
}
