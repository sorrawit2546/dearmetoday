// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ## โมเดลสำหรับผู้ใช้งาน (User)
model User {
  id        String  @id @default(uuid())
  email     String  @unique
  name      String? // จาก Google profile
  avatarUrl String? @map("avatar_url") // URL รูปจาก Google
  provider  String? // เช่น "google"
  googleId  String? @map("provider_id") // ID จาก Google

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  entries      Entry[]
  ThankMessage ThankMessage[]

  // Map Model name "User" to table name "users"
  @@map("users")
}

// ## โมเดลสำหรับบันทึก (Entry)
model Entry {
  id    String  @id @default(uuid())
  line1 String
  line2 String?
  line3 String?
  email String
  mood  Mood

  // Map camelCase fields to snake_case columns
  showMessage Boolean  @default(false) @map("show_message")
  isDelete    Boolean  @default(false) @map("is_delete")
  createdAt   DateTime @default(now()) @map("created_at")
  imageUrls   String[] @default([]) @map("image_urls")

  // Relation fields
  user   User   @relation(fields: [userId], references: [id])
  userId String @map("user_id") // Foreign key

  // Map Model name "Entry" to table name "entries"
  @@map("entries")
}

model ThankMessage {
  id           String   @id @default(uuid())
  thankMessage String   @map("thank_message")
  isDelete     Boolean  @default(false) @map("is_delete")
  createdAt    DateTime @default(now()) @map("created_at")
  // Relation fields
  user         User?    @relation(fields: [userId], references: [id])
  userId       String?  @map("user_id") // Foreign key
  @@map("thank_messages")
}

// ## Enum สำหรับอารมณ์
enum Mood {
  happy
  calm
  neutral
  tired
  sad
}
